# Environnement
APP_ENV=dev
APP_SECRET=change_me_in_production
APP_SHARE_DIR=var/share

# Symfony routing par défaut
DEFAULT_URI=http://localhost:8000

# Doctrine / PostgreSQL
DATABASE_URL="postgresql://symfony:password@127.0.0.1:5432/symfony?serverVersion=16&charset=utf8"

# Symfony Messenger (pour les jobs / mails)
MESSENGER_TRANSPORT_DSN=doctrine://default

# Symfony Mailer
MAILER_DSN=smtp://localhost:1025