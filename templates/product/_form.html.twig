{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div class="bg-white shadow-md rounded-xl p-8 border border-gray-100">
        <div class="grid grid-cols-1 gap-6">
            
            {# Champ Nom #}
            <div>
                {{ form_label(form.name, 'Nom du produit / service', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all', 'placeholder': 'ex: Développement Web'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(form.name) }}</div>
            </div>

            {# Champ Description #}
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all', 'rows': '3', 'placeholder': 'Détails de la prestation...'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(form.description) }}</div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {# Champ Prix #}
                <div>
                    {{ form_label(form.price, 'Prix Unitaire (€)', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.price, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all', 'placeholder': '0.00'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.price) }}</div>
                </div>

                {# Champ Unité #}
                <div>
                    {{ form_label(form.unit, 'Unité de mesure', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.unit, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all', 'placeholder': 'ex: heure, jour, pièce'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(form.unit) }}</div>
                </div>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-end space-x-4">
            <a href="{{ path('app_product_index') }}" class="text-sm font-medium text-gray-500 hover:text-gray-700">Annuler</a>
            <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg font-semibold shadow-sm transition-all">
                {{ button_label|default('Enregistrer le produit') }}
            </button>
        </div>
    </div>
{{ form_end(form) }}
