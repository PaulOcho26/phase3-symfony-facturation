{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block page_title %}Fiche Produit{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="mb-6 flex justify-between items-center">
            <a href="{{ path('app_product_index') }}" class="text-indigo-600 hover:underline text-sm flex items-center">
                ← Retour à la liste
            </a>
            <div class="flex space-x-3">
                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-all">
                    Modifier
                </a>
                {{ include('product/_delete_form.html.twig') }}
            </div>
        </div>

        <div class="bg-white shadow-md rounded-xl overflow-hidden border border-gray-100">
            <div class="p-8">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h3 class="text-2xl font-bold text-gray-900">{{ product.name }}</h3>
                        <p class="text-sm text-gray-500 mt-1">ID: #{{ product.id }}</p>
                    </div>
                    <span class="px-4 py-2 bg-indigo-100 text-indigo-800 rounded-full font-bold text-lg">
                        {{ product.price }} €
                    </span>
                </div>

                <div class="space-y-6">
                    <div>
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Description</h4>
                        <p class="text-gray-700 leading-relaxed bg-gray-50 p-4 rounded-lg border border-gray-100">
                            {{ product.description ?: 'Aucune description fournie.' }}
                        </p>
                    </div>

                    <div class="flex items-center space-x-8">
                        <div>
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Unité de mesure</h4>
                            <p class="text-gray-900 font-medium">{{ product.unit }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}