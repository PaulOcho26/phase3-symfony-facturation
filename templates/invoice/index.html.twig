{% extends 'base.html.twig' %}

{% block title %}Liste des factures{% endblock %}
{% block page_title %}Mes Factures{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <h3 class="text-lg font-medium text-gray-700">Toutes les factures</h3>
        <a href="{{ path('app_invoice_new') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow-sm flex items-center">
            <span class="mr-2">+</span> Créer une facture
        </a>
    </div>

    <div class="bg-white shadow-md rounded-xl overflow-hidden border border-gray-100">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Numéro</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Client</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Montant</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for invoice in invoices %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-bold text-indigo-600">{{ invoice.number }}</td>
                        <td class="px-6 py-4 text-sm">{{ invoice.customer.name }}</td>
                        <td class="px-6 py-4 text-sm font-bold">{{ invoice.totalAmount }} €</td>
                        <td class="px-6 py-4 text-xs font-bold uppercase">
                            {{ invoice.status }}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="{{ path('app_invoice_show', {id: invoice.id}) }}" class="text-indigo-600">Voir</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}