{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block page_title %}Répertoire Clients{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <h3 class="text-lg font-medium text-gray-700">Mes Clients</h3>
        <a href="{{ path('app_customer_new') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow-sm transition-all flex items-center">
            <span class="mr-2">+</span> Nouveau client
        </a>
    </div>

    <div class="bg-white shadow-md rounded-xl overflow-hidden border border-gray-100">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Client</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Contact</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">SIRET</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for customer in customers %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="text-sm font-bold text-gray-900">{{ customer.name }}</div>
                            <div class="text-sm text-gray-500">{{ customer.address|nl2br }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900">{{ customer.email }}</div>
                            <div class="text-sm text-gray-500">{{ customer.phoneNumber }}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm text-gray-600">{{ customer.siret ?: 'Non renseigné' }}</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="{{ path('app_customer_show', {'id': customer.id}) }}" class="text-indigo-600 hover:text-indigo-900 mr-3">Voir</a>
                            <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="text-amber-600 hover:text-amber-900">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-gray-500">
                            Aucun client enregistré. <a href="{{ path('app_customer_new') }}" class="text-indigo-600 underline">Ajoutez votre premier client</a>.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}