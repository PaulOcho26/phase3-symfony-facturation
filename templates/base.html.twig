<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Facturation SaaS{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧾</text></svg>">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-gray-50 font-sans antialiased text-gray-900">
    <div class="flex min-h-screen">
        <!-- Sidebar (Navigation Gauche) -->
        <aside class="w-64 bg-indigo-900 text-white flex flex-col shadow-xl">
            <div class="p-6">
                <h1 class="text-2xl font-bold tracking-tight">SaaS Facture</h1>
                <p class="text-indigo-300 text-sm">Espace Entrepreneur</p>
            </div>

            <nav class="flex-1 px-4 space-y-2 mt-4">
                <a href="{{ path('app_dashboard') }}" class="flex items-center px-4 py-3 text-indigo-100 hover:bg-indigo-800 rounded-lg transition-colors">
                    <span class="mr-3">📊</span> Dashboard
                </a>
                
                <a href="{{ path('app_product_index') }}" class="flex items-center px-4 py-3 text-indigo-100 hover:bg-indigo-800 rounded-lg transition-colors">
                    <span class="mr-3">📦</span> Produits
                </a>

                <a href="{{ path('app_customer_index') }}" class="flex items-center px-4 py-3 text-indigo-100 hover:bg-indigo-800 rounded-lg transition-colors">
                    <span class="mr-3">👥</span> Clients
                </a>

                <a href="{{ path('app_invoice_index') }}" class="flex items-center px-4 py-3 text-indigo-100 hover:bg-indigo-800 rounded-lg transition-colors">
                    <span class="mr-3">📑</span> Factures
                </a>
            </nav>

            <div class="p-4 border-t border-indigo-800">
                <a href="{{ path('app_profile') }}" class="flex items-center px-4 py-3 text-indigo-100 hover:bg-indigo-800 rounded-lg transition-colors text-sm">
                    <span class="mr-3">👤</span> Mon Profil
                </a>
                {# Le lien de déconnexion utilise généralement la route app_logout #}
                <a href="{{ path('app_logout') }}" class="flex items-center px-4 py-3 text-red-300 hover:bg-red-900 rounded-lg transition-colors text-sm">
                    <span class="mr-3">🚪</span> Déconnexion
                </a>
            </div>
        </aside>

        <!-- Main Content (Zone de droite) -->
        <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <!-- Header / Topbar -->
            <header class="bg-white border-b border-gray-200 py-4 px-8 flex justify-between items-center">
                <h2 class="text-xl font-semibold text-gray-800">
                    {% block page_title %}{% endblock %}
                </h2>
                <div class="text-sm text-gray-500">
                    {{ "now"|date("d/m/Y") }}
                </div>
            </header>

            <!-- Page Content -->
            <div class="flex-1 overflow-y-auto p-8">
             {# --- AJOUT DU BLOC DE MESSAGES ICI --- #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-4 rounded-lg shadow-sm border {{ label == 'success' ? 'bg-green-100 border-green-200 text-green-700' : 'bg-red-100 border-red-200 text-red-700' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    {# -------------------------------------- #}
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>
</body>
</html>